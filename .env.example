# Скопіюйте у .env.local і заповніть.
# Увага: .gitignore ловить `.env*`, тож цей файл додано в git примусово
# (git add -f). Реальні значення тримайте лише в .env.local.

# — Адреса сайту —
# Канонічний домен: з нього будуються OG-картинка, sitemap.xml, robots.txt
# і schema.org. На Vercel можна лишити порожнім — тоді береться
# VERCEL_PROJECT_PRODUCTION_URL. Зі своїм доменом задайте явно, інакше
# canonical вказуватиме на *.vercel.app. Без завершального «/».
NEXT_PUBLIC_SITE_URL=

# — Supabase —
# Settings → API Keys → service_role. Ключ має повний доступ в обхід RLS,
# тому живе тільки на сервері й ніколи не має префікса NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Оновлення адмінки в реальному часі (необов'язково).
# Settings → API Keys → anon/public. Цей ключ навмисно публічний: він потрапляє
# в бандл браузера й дає рівно один доступ — читати таблицю realtime_pings,
# у якій немає нічого, крім назви зміненої таблиці й часу (див. міграцію
# 0003_realtime.sql). Дані з бази в браузер не течуть у жодному разі.
# Без цих двох змінних адмінка працює як раніше — просто не оновлюється сама.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# — Сесія адмінки —
# openssl rand -base64 32
SESSION_SECRET=

# Хеш пароля адміна, не сам пароль.
# Згенерувати: npm run admin:hash -- 'ваш-пароль'
# Формат scrypt:<сіль>:<хеш> — роздільник «:», бо «$» .env-парсери
# сприймають як змінну і обрізають значення.
ADMIN_PASSWORD_HASH=

# — Telegram-сповіщення про нові заявки (необов'язково) —
# Токен від @BotFather; chat id — від @userinfobot після /start вашому боту.
# Без них система працює, просто не надсилає сповіщень.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
