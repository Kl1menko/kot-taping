{
  "name": "beauty_tape",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit && npm run test:tz",
    "test:unit": "TZ=Europe/Kyiv node --test --experimental-strip-types --no-warnings \"src/**/!(*.tz).test.ts\"",
    "test:tz": "TZ=UTC node --test --experimental-strip-types --no-warnings \"src/**/*.tz.test.ts\"",
    "admin:hash": "node scripts/hash-password.mjs",
    "db:seed": "node --experimental-strip-types --no-warnings scripts/seed.mjs",
    "db:demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "jose": "^6.2.8",
    "next": "16.3.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
